{
  "name": "kantanproex-desktop",
  "productName": "KantanProEX",
  "version": "1.0.70",
  "description": "KantanProEX のデスクトップ版（ブラウザもネットも不要）",
  "main": "main.js",
  "private": true,
  "author": "KantanPro",
  "scripts": {
    "prepare:php": "scripts/fetch-php.sh",
    "prepare:site": "scripts/build-site.sh",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build:mac": "scripts/build-site.sh && (chmod -R u+rwX dist/mac dist/mac-universal* 2>/dev/null; rm -rf dist/mac dist/mac-universal*) && env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg --universal && mv dist/mac-universal dist/mac && rm -rf dist/mac-universal-*-temp",
    "install:local": "scripts/install-local.sh",
    "build:icon": "node scripts/build-icon.mjs",
    "build:win": "scripts/fetch-php-win.sh && scripts/build-site.sh && (chmod -R u+rwX dist/win-unpacked 2>/dev/null; rm -rf dist/win-unpacked) && env -u ELECTRON_RUN_AS_NODE electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kantanpro.kantanproex.desktop",
    "productName": "KantanProEX",
    "afterPack": "scripts/after-pack.js",
    "copyright": "KantanPro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "lib/**/*",
      "package.json",
      "assets/icon/mark-256.png"
    ],
    "extraResources": [
      {
        "from": "php",
        "to": "php"
      },
      {
        "from": "site-template",
        "to": "site-template"
      }
    ],
    "electronLanguages": [
      "ja",
      "en",
      "en-US"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "x64ArchFiles": "Contents/Resources/bin/php",
      "identity": null,
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin"
        }
      ]
    },
    "dmg": {
      "title": "KantanProEX",
      "background": "build/background.png",
      "window": {
        "width": 660,
        "height": 646
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 165,
          "y": 170,
          "type": "file"
        },
        {
          "x": 495,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon/icon-1024.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "bin-win",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ja_JP"
      ],
      "displayLanguageSelector": false,
      "artifactName": "KantanProEX-Setup-${version}.exe",
      "shortcutName": "KantanProEX",
      "include": "build/installer.nsh"
    }
  }
}
